package java

import (
    "fmt"
    "path"
    "strings"

    "goforge.dev/refine/language"
    refineopenapi "goforge.dev/refine/openapi"
)

// GenerateOpenAPIContext emits a pure Java 25 request/response validation
// facade over the same checked operation metadata used by Go. It generates no
// transport, routing, network, or filesystem behavior.
func GenerateOpenAPIContext(program *language.Program,namespace,contractName,className string,schema refineopenapi.Schema)(files []File,failure error){
    if err:=javaClassName(className);err!=nil{return nil,err};if strings.EqualFold(className,contractName){return nil,&GenerationError{Message:"OpenAPI facade and contract class names must differ"}}
    checked,err:=refineopenapi.Compile(program,&schema);if err!=nil{return nil,err};snapshot:=checked.Schema();total:=0
    entries:=[]string{};descriptors:=[]string{}
    for _,operation:=range snapshot.Operations{
        responses:=[]string{}
        for _,response:=range operation.Responses{if total>=256{return nil,&GenerationError{Message:"OpenAPI Java facade supports at most 256 response bindings"}};total++;responses=append(responses,"new ResponseBinding("+javaQuote(response.Status)+","+javaQuote(response.ResponseType)+","+javaQuote(response.ContextType)+")")}
        entries=append(entries,"java.util.Map.entry("+javaQuote(operation.OperationID)+",new Binding("+javaQuote(operation.RequestType)+",java.util.List.of("+strings.Join(responses,",")+")))")
        descriptors=append(descriptors,"new Operation("+javaQuote(operation.OperationID)+","+javaQuote(operation.Method)+","+javaQuote(operation.Path)+")")
    }
    files,err=GenerateValidator(program,namespace,contractName);if err!=nil{return nil,err};prefix:=strings.ReplaceAll(namespace,".","/");targetPath:=path.Join(prefix,className+".java");for _,file:=range files{if strings.EqualFold(file.Path,targetPath){return nil,&GenerationError{Message:"OpenAPI facade source name collides with generated runtime"}}}
    header:="// Generated by Refine: pure OpenAPI request/response validation context. MIT licensed.\n";if namespace!=""{header+="package "+namespace+";\n"}
    source:=fmt.Sprintf(openAPIContextJava,className,className,strings.Join(entries,","),strings.Join(descriptors,","),contractName,contractName,contractName,contractName);files=append(files,File{Path:targetPath,Source:header+source});return files,nil
}

const openAPIContextJava=`
public final class %s {
    private %s(){}
    public record Request(Data parameters,Data headers,Data body)implements java.io.Serializable{
        @java.io.Serial private static final long serialVersionUID=1L;
        public Request{java.util.Objects.requireNonNull(parameters);java.util.Objects.requireNonNull(headers);java.util.Objects.requireNonNull(body);}
    }
    public record Response(Data headers,Data body)implements java.io.Serializable{
        @java.io.Serial private static final long serialVersionUID=1L;
        public Response{java.util.Objects.requireNonNull(headers);java.util.Objects.requireNonNull(body);}
    }
    public record Operation(String operationId,String method,String path)implements java.io.Serializable{
        @java.io.Serial private static final long serialVersionUID=1L;
        public Operation{java.util.Objects.requireNonNull(operationId);java.util.Objects.requireNonNull(method);java.util.Objects.requireNonNull(path);}
    }
    private record ResponseBinding(String status,String responseType,String contextType){}
    private record Binding(String requestType,java.util.List<ResponseBinding> responses){Binding{responses=java.util.List.copyOf(responses);}}
    private static final java.util.Map<String,Binding> BINDINGS=java.util.Map.ofEntries(%s);
    private static final java.util.List<Operation> OPERATIONS=java.util.List.of(%s);
    public static java.util.List<Operation> operations(){return OPERATIONS;}
    private static Data requestData(Request request){return new Data.Struct(java.util.List.of(new Data.Field("parameters",request.parameters()),new Data.Field("headers",request.headers()),new Data.Field("body",request.body())));}
    private static Data responseData(Response response){return new Data.Struct(java.util.List.of(new Data.Field("headers",response.headers()),new Data.Field("body",response.body())));}
    private static Data contextData(Request request,Response response){return new Data.Struct(java.util.List.of(new Data.Field("request",requestData(request)),new Data.Field("response",responseData(response))));}
    private static Binding operation(String operationId){var binding=operationId==null?null:BINDINGS.get(operationId);if(binding==null)throw new IllegalArgumentException("unknown OpenAPI operationId");return binding;}
    private static boolean runtimeStatus(String status){return status!=null&&status.length()==3&&status.charAt(0)>='1'&&status.charAt(0)<='5'&&status.charAt(1)>='0'&&status.charAt(1)<='9'&&status.charAt(2)>='0'&&status.charAt(2)<='9';}
    private static ResponseBinding response(Binding binding,String status){if(!runtimeStatus(status))throw new IllegalArgumentException("response status must be 100-599");String family=status.substring(0,1)+"XX";ResponseBinding fallback=null;for(var candidate:binding.responses()){if(candidate.status().equals(status))return candidate;if(candidate.status().equals(family))fallback=candidate;else if(candidate.status().equals("default")&&fallback==null)fallback=candidate;}if(fallback==null)throw new IllegalArgumentException("response status has no binding");return fallback;}
    private static Validation.Outcome missingRequest(){return new Validation.Indeterminate(java.util.List.of(new Validation.Diagnostic("openapi.request_context.missing",java.util.List.of("request"),"","Original request context is required for response validation.")));}
    private static Validation.Outcome merge(Validation.Outcome first,Validation.Outcome second){var details=new java.util.ArrayList<Validation.Diagnostic>();details.addAll(first.diagnostics());details.addAll(second.diagnostics());boolean invalid=first.state()==Validation.State.INVALID||second.state()==Validation.State.INVALID;boolean incomplete=first.incomplete()||second.incomplete();return invalid?new Validation.Invalid(details,incomplete):incomplete?new Validation.Indeterminate(details):new Validation.Valid();}
    public static Validation.Outcome validateRequest(String operationId,Request request){return validateRequest(operationId,request,Budget.Limits.defaults());}
    public static Validation.Outcome validateRequest(String operationId,Request request,Budget.Limits limits){java.util.Objects.requireNonNull(request);java.util.Objects.requireNonNull(limits);return %s.validate(operation(operationId).requestType(),requestData(request),limits);}
    public static Validation.Outcome validateResponse(String operationId,String status,Response response,Request original){return validateResponse(operationId,status,response,original,Budget.Limits.defaults());}
    public static Validation.Outcome validateResponse(String operationId,String status,Response response,Request original,Budget.Limits limits){java.util.Objects.requireNonNull(response);java.util.Objects.requireNonNull(limits);var selected=response(operation(operationId),status);if(selected.contextType().isEmpty())return %s.validate(selected.responseType(),responseData(response),limits);if(original==null)return merge(%s.validate(selected.responseType(),responseData(response),limits),missingRequest());return %s.validate(selected.contextType(),contextData(original,response),limits);}
}
`
