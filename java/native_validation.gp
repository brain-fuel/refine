package java

import (
    "fmt"
    "path"
    "strings"

    "goforge.dev/refine/native"
)

// GenerateProjectNativeJSONValidator emits an offline native-schema validator
// for a JSON Schema Draft 2020-12 or OpenAPI 3.x project. OAS 3.0 resources are
// first adapted by native.Project to equivalent Draft 2020-12 assertions. The public helper
// validates bytes only; callers compose it with their semantic serde so that
// both the immutable native sidecar and editable refinements are enforced.
// Patterns are rejected until the generated runtime has a bounded ECMA-262
// engine; substituting Java or Joni regular expressions would be unsound.
func GenerateProjectNativeJSONValidator(project *native.Project,className string)(files []File,failure error){
    defer func(){if caught:=recover();caught!=nil{if err,ok:=caught.(*GenerationError);ok{files=nil;failure=err}else{panic(caught)}}}()
    if project==nil{return nil,&GenerationError{Message:"a checked native project is required"}};if err:=javaClassName(className);err!=nil{return nil,&GenerationError{Message:err.Error()}}
    resources,err:=project.CanonicalJSONResources();if err!=nil{return nil,&GenerationError{Message:err.Error()}};if len(resources)==0{return nil,&GenerationError{Message:"native JSON project has no resources"}};if len(resources)>128{return nil,&GenerationError{Message:"generated native JSON validation supports at most 128 resources"}}
    locations,err:=project.JSONSchemaKeywordLocations("pattern","patternProperties");if err!=nil{return nil,&GenerationError{Message:"native schema-position indexing failed: "+err.Error()}};if len(locations)>0{return nil,&GenerationError{Message:"generated native JSON validation requires a bounded ECMA-262 engine for "+locations[0]}}
    total:=0;rootFound:=false;methods:=[]string{};entries:=[]string{};for index,resource:=range resources{total+=len(resource.Source);if total>4<<20{return nil,&GenerationError{Message:"generated native JSON validation resources exceed 4 MiB"}};if resource.URI==project.Root().Resource{rootFound=true}
        method:=fmt.Sprintf("resource%d",index);methods=append(methods,"    private static String "+method+"(){return "+javaChunkedString(resource.Source)+";}");entries=append(entries,"java.util.Map.entry("+javaQuote(resource.URI)+","+method+"())")
    };if !rootFound{return nil,&GenerationError{Message:"native JSON root resource is absent"}}
    dialect:="com.networknt.schema.dialect.Dialects.getDraft202012()";dialects:="java.util.List.of("+dialect+")";if project.Format()==native.OpenAPI&&!strings.HasPrefix(project.Version(),"3.0."){dialect="com.networknt.schema.dialect.Dialects.getOpenApi31()";dialects="java.util.List.of("+dialect+",com.networknt.schema.dialect.Dialects.getDraft202012())"}
    root:=project.Root().Resource;if project.Root().Pointer!=""{root+="#"+project.Root().Pointer};metadata:=project.Metadata();namespace:=metadata.PublicationNamespace;header:="// Generated by Refine: offline native JSON Schema validation. MIT licensed.\n";if namespace!=""{header+="package "+namespace+";\n"};source:=fmt.Sprintf(nativeJSONValidatorJava,className,metadata.NumericExpansionLimit(),strings.Join(entries,","),strings.Join(methods,"\n"),dialects,javaQuote(root),className,className)
    return []File{{Path:path.Join(strings.ReplaceAll(namespace,".","/"),className+".java"),Source:header+source}},nil
}

func javaChunkedString(value string)string{runes:=[]rune(value);parts:=[]string{};for len(runes)>0{size:=8000;if len(runes)<size{size=len(runes)};parts=append(parts,".append("+javaQuote(string(runes[:size]))+")");runes=runes[size:]};if len(parts)==0{return `""`};return "new StringBuilder("+fmt.Sprint(len(value))+")"+strings.Join(parts,"")+".toString()"}

const nativeJSONValidatorJava=`
public final class %s {
    public record Limits(int maxBytes,int maxDepth,long maxNodes,int maxNumberLength,int maxStringLength,int maxNameLength,int maxNumericExpansion){public Limits{if(maxBytes<=0||maxDepth<=0||maxNodes<=0||maxNumberLength<=0||maxStringLength<=0||maxNameLength<=0||maxNumericExpansion<=0||maxNumericExpansion>1_000_000)throw new IllegalArgumentException("Native JSON limits must be positive and numeric expansion at most 1000000.");}public static Limits defaults(){return new Limits(1<<20,128,10000,10000,1<<20,10000,%d);}}
    public enum Code{INVALID,RESOURCE_LIMIT,ENFORCEMENT}
    public static final class NativeValidationException extends IllegalArgumentException{private static final long serialVersionUID=1L;private final Code code;private NativeValidationException(String message){this(Code.INVALID,message);}private NativeValidationException(Code code,String message){super(message);this.code=java.util.Objects.requireNonNull(code);}public Code code(){return code;}public boolean isResourceLimit(){return code==Code.RESOURCE_LIMIT;}public boolean isIndeterminate(){return code!=Code.INVALID;}}
    private static final java.util.Map<String,String> RESOURCES=java.util.Map.ofEntries(%s);
%s
    private static final java.util.List<com.networknt.schema.dialect.Dialect> DIALECTS=%s;
    private static final String ROOT=%s;
    private final Limits limits;private final tools.jackson.databind.ObjectMapper instanceMapper;private final com.networknt.schema.Schema schema;
    public %s(){this(Limits.defaults());}public %s(Limits limits){this.limits=java.util.Objects.requireNonNull(limits);this.instanceMapper=mapper(limits);this.schema=compile();}
    public void validate(String input){java.util.Objects.requireNonNull(input);if(input.length()>limits.maxBytes())throw new NativeValidationException(Code.RESOURCE_LIMIT,"Native JSON input byte limit exceeded.");for(int i=0;i<input.length();i++){char unit=input.charAt(i);if(Character.isHighSurrogate(unit)){if(i+1>=input.length()||!Character.isLowSurrogate(input.charAt(++i)))throw new NativeValidationException("JSON text contains an unpaired UTF-16 surrogate.");}else if(Character.isLowSurrogate(unit))throw new NativeValidationException("JSON text contains an unpaired UTF-16 surrogate.");}validate(input.getBytes(java.nio.charset.StandardCharsets.UTF_8));}
    public void validate(byte[] input){java.util.Objects.requireNonNull(input);if(input.length>limits.maxBytes())throw new NativeValidationException(Code.RESOURCE_LIMIT,"Native JSON input byte limit exceeded.");checkNumericExpansion(input,limits.maxNumericExpansion());try{var value=instanceMapper.readTree(input);if(value==null)throw new NativeValidationException("Expected one JSON value.");var result=schema.validate(value,com.networknt.schema.OutputFormat.FLAG);if(!result.isValid())throw new NativeValidationException("JSON payload does not satisfy the native schema.");}catch(NativeValidationException failure){throw failure;}catch(tools.jackson.core.exc.StreamConstraintsException failure){throw new NativeValidationException(Code.RESOURCE_LIMIT,"Native JSON parser resource limit exceeded.");}catch(tools.jackson.core.JacksonException failure){throw new NativeValidationException("Invalid JSON payload.");}catch(RuntimeException failure){throw new NativeValidationException(Code.ENFORCEMENT,"Native JSON validation could not complete.");}}
    private static void checkNumericExpansion(byte[] input,int limit){long used=0;boolean string=false,escaped=false;for(int i=0;i<input.length;i++){int unit=input[i]&255;if(string){if(escaped){escaped=false;continue;}if(unit=='\\'){escaped=true;continue;}if(unit=='"')string=false;continue;}if(unit=='"'){string=true;continue;}if(unit!='-'&&(unit<'0'||unit>'9'))continue;int start=i,exponent=-1;while(i+1<input.length){int next=input[i+1]&255;if((next>='0'&&next<='9')||next=='-'||next=='+'||next=='.'||next=='e'||next=='E'){i++;if(next=='e'||next=='E')exponent=i;}else break;}long magnitude=0;if(exponent>=0){int j=exponent+1;if(j<=i&&((input[j]&255)=='+'||(input[j]&255)=='-'))j++;for(;j<=i;j++){int digit=(input[j]&255)-'0';if(digit<0||digit>9)break;if(magnitude>(limit-digit)/10L)throw new NativeValidationException(Code.RESOURCE_LIMIT,"Native JSON numeric expansion limit exceeded.");magnitude=magnitude*10L+digit;}}long token=(long)i-start+1;if(token>limit-used||magnitude>limit-used-token)throw new NativeValidationException(Code.RESOURCE_LIMIT,"Native JSON numeric expansion limit exceeded.");used+=token+magnitude;}}
    private static tools.jackson.databind.ObjectMapper mapper(Limits limits){var constraints=tools.jackson.core.StreamReadConstraints.builder().maxDocumentLength(limits.maxBytes()).maxNestingDepth(limits.maxDepth()).maxTokenCount(limits.maxNodes()).maxNumberLength(limits.maxNumberLength()).maxStringLength(limits.maxStringLength()).maxNameLength(limits.maxNameLength()).build();var factory=tools.jackson.core.json.JsonFactory.builder().streamReadConstraints(constraints).enable(tools.jackson.core.StreamReadFeature.STRICT_DUPLICATE_DETECTION).build();return tools.jackson.databind.json.JsonMapper.builder(factory).nodeFactory(new ExactNodeFactory()).enable(tools.jackson.databind.DeserializationFeature.USE_BIG_DECIMAL_FOR_FLOATS,tools.jackson.databind.DeserializationFeature.USE_BIG_INTEGER_FOR_INTS,tools.jackson.databind.DeserializationFeature.FAIL_ON_READING_DUP_TREE_KEY,tools.jackson.databind.DeserializationFeature.FAIL_ON_TRAILING_TOKENS).build();}
    private static tools.jackson.databind.ObjectMapper schemaMapper(){var constraints=tools.jackson.core.StreamReadConstraints.builder().maxDocumentLength(4L<<20).maxNestingDepth(1024).maxTokenCount(1_000_000).maxNumberLength(100_000).maxStringLength(4_000_000).maxNameLength(100_000).build();var factory=tools.jackson.core.json.JsonFactory.builder().streamReadConstraints(constraints).enable(tools.jackson.core.StreamReadFeature.STRICT_DUPLICATE_DETECTION).build();return tools.jackson.databind.json.JsonMapper.builder(factory).nodeFactory(new ExactNodeFactory()).enable(tools.jackson.databind.DeserializationFeature.USE_BIG_DECIMAL_FOR_FLOATS,tools.jackson.databind.DeserializationFeature.USE_BIG_INTEGER_FOR_INTS,tools.jackson.databind.DeserializationFeature.FAIL_ON_READING_DUP_TREE_KEY,tools.jackson.databind.DeserializationFeature.FAIL_ON_TRAILING_TOKENS).build();}
    private static com.networknt.schema.Schema compile(){var config=com.networknt.schema.SchemaRegistryConfig.builder().typeLoose(false).failFast(true).build();var registry=com.networknt.schema.SchemaRegistry.withDialects(DIALECTS,builder->builder.nodeReader(reader->reader.jsonMapper(schemaMapper())).schemaLoader(new EmbeddedLoader()).schemaRegistryConfig(config));return registry.getSchema(com.networknt.schema.SchemaLocation.of(ROOT));}
    private static final class EmbeddedLoader extends com.networknt.schema.resource.SchemaLoader{EmbeddedLoader(){super(java.util.List.of(),java.util.List.of());}@Override public com.networknt.schema.resource.InputStreamSource getSchemaResource(com.networknt.schema.AbsoluteIri location){String value=RESOURCES.get(location.toString());if(value==null&&location.toString().endsWith("#"))value=RESOURCES.get(location.toString().substring(0,location.toString().length()-1));if(value==null)return null;byte[] bytes=value.getBytes(java.nio.charset.StandardCharsets.UTF_8);return ()->new java.io.ByteArrayInputStream(bytes);}}
    private static final class ExactNodeFactory extends tools.jackson.databind.node.JsonNodeFactory{private static final long serialVersionUID=1L;private static tools.jackson.databind.node.DecimalNode decimal(java.math.BigDecimal value){long scale=Math.abs((long)value.scale());if(scale>1_000_000L||(long)value.precision()+scale>2_000_000L)throw new ArithmeticException("exact number expansion limit");return tools.jackson.databind.node.DecimalNode.valueOf(value);}@Override public tools.jackson.databind.node.NumericNode numberNode(byte value){return decimal(java.math.BigDecimal.valueOf(value));}@Override public tools.jackson.databind.node.NumericNode numberNode(short value){return decimal(java.math.BigDecimal.valueOf(value));}@Override public tools.jackson.databind.node.NumericNode numberNode(int value){return decimal(java.math.BigDecimal.valueOf(value));}@Override public tools.jackson.databind.node.NumericNode numberNode(long value){return decimal(java.math.BigDecimal.valueOf(value));}@Override public tools.jackson.databind.node.ValueNode numberNode(java.math.BigInteger value){return value==null?nullNode():decimal(new java.math.BigDecimal(value));}@Override public tools.jackson.databind.node.NumericNode numberNode(float value){return decimal(new java.math.BigDecimal(Float.toString(value)));}@Override public tools.jackson.databind.node.NumericNode numberNode(double value){return decimal(java.math.BigDecimal.valueOf(value));}@Override public tools.jackson.databind.node.ValueNode numberNode(java.math.BigDecimal value){return value==null?nullNode():decimal(value);}}
}
`
