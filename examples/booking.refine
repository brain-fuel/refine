package example.booking

-- Explicit civil time is appropriate for this business rule. This does not
-- claim a count of elapsed SI seconds across leap seconds.
type Booking = { checkIn :: Timestamp, checkOut :: Timestamp }
  where it.checkOut > it.checkIn @code "booking.order"
  where case civilSecondsUntil it.checkIn it.checkOut of {
    Ok seconds -> seconds <= 2592000.0;
    Err _ -> False
  } @code "booking.maximum_stay"
    @message "A booking must span at most 30 civil-coordinate days."
